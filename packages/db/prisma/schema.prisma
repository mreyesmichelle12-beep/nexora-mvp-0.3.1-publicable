// NEXORA · esquema de base de datos (PostgreSQL)
// Principios:
//  - Catálogo académico 100 % administrable (University → Faculty → Career → Subject).
//  - Datos demo marcados con isDemo y filtrados centralmente (ver src/index.ts).
//  - Roles en tabla propia (un docente puede ser también conferencista).
//  - Estado de pago SOLO escrito por webhook verificado (WebhookEvent + idempotencia).
//  - Minimización: no se guarda edad, ni historial de conversaciones de IA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  STUDENT
  MENTOR
  TEACHER
  CONFERENCE_HOST
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum VerificationMethod {
  INSTITUTIONAL_EMAIL
  MANUAL_REVIEW
}

enum StudyModality {
  ONLINE
  IN_PERSON
  HYBRID
}

enum StudyStyle {
  GROUP_DISCUSSION
  PRACTICE_EXERCISES
  SILENT_COMPANY
  TEACH_EACH_OTHER
  EXAM_PREP
  PROJECT_WORK
}

enum SubjectRelation {
  ENROLLED
  STRUGGLING
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum ProfileVisibility {
  MEMBERS
  CONNECTIONS
  PRIVATE
}

enum MessagePolicy {
  CONNECTIONS_ONLY
  NOBODY
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReportTargetType {
  USER
  MESSAGE
  FILE
  ROOM
  CONFERENCE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum LibraryCategory {
  NOTES
  GUIDE
  SLIDES
  EXERCISES
  EXAM
  DOCUMENT
}

enum FileStatus {
  PENDING_SCAN
  QUARANTINED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REMOVED
}

enum RoomVisibility {
  PUBLIC_TO_MEMBERS
  CONNECTIONS_ONLY
  INVITE_ONLY
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RoomMemberRole {
  HOST
  PARTICIPANT
}

enum SessionKind {
  SOLO
  ROOM
}

enum GoalStatus {
  ACTIVE
  DONE
  ARCHIVED
}

enum CalendarEventType {
  CLASS
  CONFERENCE
  STUDY_ROOM
  STUDY_SESSION
  GOAL
  OTHER
}

enum ActivityMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum PlanCode {
  FREE
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ConsentType {
  TERMS
  PRIVACY
  COOKIES_ANALYTICS
  COOKIES_PREFERENCES
  MARKETING
}

enum DataRequestType {
  EXPORT
  CORRECTION
  DELETION
}

enum DataRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  SPAM
}

enum ImpactSection {
  CONTEXT
  PROBLEM
  OBJECTIVES
  PLANNING
  ACTIVITIES
  PARTICIPATION
  RESULTS
  EVIDENCE
  LEARNINGS
  REFLECTION
  SDG
}

// ───────────────────────── Identidad y acceso ─────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique // normalizado a minúsculas en la capa de servicio
  emailVerifiedAt DateTime?
  passwordHash    String? // null si solo usa OAuth
  status          UserStatus @default(PENDING_VERIFICATION)
  isDemo          Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  roles                UserRole[]
  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  profile              Profile?
  privacy              PrivacySetting?
  student              StudentProfile?
  notificationPrefs    NotificationPreference?
  streak               Streak?
  subscription         Subscription?
  skills               UserSkill[]
  interests            UserInterest[]
  availability         Availability[]
  verificationRequests VerificationRequest[] @relation("VerificationSubject")
  consents             Consent[]
  dataRequests         DataRequest[]
  goals                Goal[]
  calendarEvents       CalendarEvent[]
  studySessions        StudySession[]
  notifications        Notification[]
  savedFiles           SavedFile[]
  uploads              LibraryFile[]            @relation("Uploader")
  hostedRooms          StudyRoom[]              @relation("RoomHost")
  roomMemberships      StudyRoomMember[]
  classesTaught        TeacherClass[]           @relation("ClassOwner")
  classEnrollments     ClassEnrollment[]
  conferencesHosted    Conference[]             @relation("ConferenceHost")
  conferenceAttendance ConferenceParticipant[]
  sentRequests         Connection[]             @relation("ConnectionRequester")
  receivedRequests     Connection[]             @relation("ConnectionAddressee")
  blocksMade           Block[]                  @relation("Blocker")
  blocksReceived       Block[]                  @relation("Blocked")
  conversationMembers  ConversationMember[]
  messagesSent         Message[]
  reportsFiled         Report[]                 @relation("Reporter")
  aiUsage              AiUsage[]

  @@index([status])
  @@index([isDemo])
  @@map("users")
}

model UserRole {
  id             String             @id @default(cuid())
  userId         String
  role           Role
  verification   VerificationStatus @default(NOT_REQUIRED)
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// Sesiones propias: el token en claro solo vive en la cookie; aquí solo su hash.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime // expiración absoluta
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?   @db.VarChar(255)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google"
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String // correo que se está verificando
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Docentes/mentores/conferencistas: ningún rol sensible se concede sin pasar por aquí.
model VerificationRequest {
  id               String             @id @default(cuid())
  userId           String
  role             Role
  method           VerificationMethod
  institutionEmail String?
  evidenceNote     String?            @db.VarChar(1000)
  status           VerificationStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?            @db.VarChar(1000)
  createdAt        DateTime           @default(now())
  user             User               @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("verification_requests")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String   @db.VarChar(80)
  lastName    String   @db.VarChar(80)
  avatarKey   String? // clave en almacenamiento, no URL pública
  bio         String?  @db.VarChar(400)
  institution String? // docentes: institución declarada
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model PrivacySetting {
  userId                  String            @id
  profileVisibility       ProfileVisibility @default(MEMBERS)
  showInRoomPreviews      Boolean           @default(false) // aparecer como "conexión presente"
  allowMatchSuggestions   Boolean           @default(true)
  allowConnectionRequests Boolean           @default(true)
  messagePolicy           MessagePolicy     @default(CONNECTIONS_ONLY)
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model Consent {
  id            String      @id @default(cuid())
  userId        String?
  anonymousId   String? // visitantes sin cuenta (banner de cookies)
  type          ConsentType
  granted       Boolean
  policyVersion String
  createdAt     DateTime    @default(now())
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([anonymousId, type])
  @@map("consents")
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(RECEIVED)
  note        String?           @db.VarChar(1000)
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("data_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // p. ej. "auth.login", "file.approve", "user.block"
  targetType String?
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Catálogo académico (administrable) ─────────────────────────

model University {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  emailDomains String[] // dominios institucionales; vacío ⇒ verificación manual
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  faculties    Faculty[]
  careers      Career[]
  students     StudentProfile[]

  @@map("universities")
}

model Faculty {
  id           String     @id @default(cuid())
  universityId String
  name         String
  active       Boolean    @default(true)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  careers      Career[]

  @@unique([universityId, name])
  @@map("faculties")
}

model Career {
  id           String     @id @default(cuid())
  universityId String
  facultyId    String?
  name         String
  totalCycles  Int? // número de ciclos del plan, si se conoce
  active       Boolean    @default(true)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  faculty      Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  subjects     Subject[]
  students     StudentProfile[]

  @@unique([universityId, name])
  @@map("careers")
}

model Subject {
  id        String  @id @default(cuid())
  careerId  String
  name      String
  code      String?
  cycle     Int // ciclo/nivel en el plan
  active    Boolean @default(true)
  career    Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)

  studentLinks StudentSubject[]
  files        LibraryFile[]
  rooms        StudyRoom[]
  classes      TeacherClass[]
  goals        Goal[]

  @@unique([careerId, name])
  @@index([careerId, cycle])
  @@map("subjects")
}

// ───────────────────────── Perfil académico ─────────────────────────

model StudentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  universityId   String
  careerId       String
  cycle          Int
  modality       StudyModality   @default(HYBRID)
  studyStyles    StudyStyle[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  university     University      @relation(fields: [universityId], references: [id])
  career         Career          @relation(fields: [careerId], references: [id])
  subjects       StudentSubject[]

  @@index([universityId, careerId, cycle])
  @@map("student_profiles")
}

model StudentSubject {
  studentProfileId String
  subjectId        String
  relation         SubjectRelation
  student          StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, subjectId, relation])
  @@index([subjectId])
  @@map("student_subjects")
}

model Availability {
  id          String @id @default(cuid())
  userId      String
  dayOfWeek   Int // 0 = domingo … 6 = sábado
  startMinute Int // minutos desde 00:00
  endMinute   Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("availability")
}

model Interest {
  id     String         @id @default(cuid())
  name   String         @unique
  active Boolean        @default(true)
  users  UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model Skill {
  id     String      @id @default(cuid())
  name   String      @unique
  active Boolean     @default(true)
  users  UserSkill[]

  @@map("skills")
}

model UserSkill {
  userId  String
  skillId String
  level   SkillLevel
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

// ───────────────────────── Social ─────────────────────────

// Par ordenado: userAId < userBId (lo garantiza la capa de servicio).
model Match {
  id               String   @id @default(cuid())
  userAId          String
  userBId          String
  score            Int // 0–100
  breakdown        Json // puntaje por factor
  algorithmVersion String
  computedAt       DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId, score])
  @@index([userBId, score])
  @@map("matches")
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("connections")
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

// El estado de lectura vive aquí (lastReadAt), no en cada mensaje.
model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Reporte genérico: cubre usuarios, mensajes, archivos (file_reports), salas y conferencias.
model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String           @db.VarChar(80)
  details      String?          @db.VarChar(1000)
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  reporter     User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

// ───────────────────────── Biblioteca ─────────────────────────

model LibraryFile {
  id           String          @id @default(cuid())
  uploaderId   String
  subjectId    String?
  title        String          @db.VarChar(160)
  description  String?         @db.VarChar(600)
  category     LibraryCategory
  status       FileStatus      @default(PENDING_SCAN)
  storageKey   String          @unique // clave en bucket privado; se sirve con URL firmada
  originalName String          @db.VarChar(200)
  sizeBytes    Int
  sha256       String
  declaredMime String
  detectedMime String? // detectado por firma de contenido, no por la extensión
  isDemo       Boolean         @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?         @db.VarChar(300)
  createdAt    DateTime        @default(now())
  uploader     User            @relation("Uploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  subject      Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  saved        SavedFile[]
  materials    ActivityMaterial[]

  @@index([status, category])
  @@index([subjectId])
  @@index([sha256])
  @@map("library_files")
}

model SavedFile {
  userId    String
  fileId    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      LibraryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([userId, fileId])
  @@map("saved_files")
}

// ───────────────────────── Study Rooms y progreso ─────────────────────────

model StudyRoom {
  id              String         @id @default(cuid())
  hostId          String
  subjectId       String?
  title           String         @db.VarChar(120)
  description     String?        @db.VarChar(400)
  visibility      RoomVisibility @default(PUBLIC_TO_MEMBERS)
  status          RoomStatus     @default(SCHEDULED)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  maxParticipants Int            @default(8)
  videoRoomName   String         @unique // nombre de sala en el proveedor de video
  isDemo          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  host            User           @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  members         StudyRoomMember[]
  whiteboard      RoomWhiteboard?
  sessions        StudySession[]
  calendarEvents  CalendarEvent[]

  @@index([status, scheduledStart])
  @@map("study_rooms")
}

model StudyRoomMember {
  roomId   String
  userId   String
  role     RoomMemberRole @default(PARTICIPANT)
  joinedAt DateTime       @default(now())
  leftAt   DateTime?
  room     StudyRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("study_room_members")
}

model RoomWhiteboard {
  roomId    String    @id
  state     Bytes // documento Yjs serializado
  updatedAt DateTime  @updatedAt
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_whiteboards")
}

model StudySession {
  id           String      @id @default(cuid())
  userId       String
  roomId       String?
  kind         SessionKind
  startedAt    DateTime
  endedAt      DateTime?
  focusMinutes Int         @default(0)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         StudyRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("study_sessions")
}

model Streak {
  userId           String   @id
  current          Int      @default(0)
  longest          Int      @default(0)
  lastActivityDate DateTime? @db.Date
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Goal {
  id         String     @id @default(cuid())
  userId     String
  subjectId  String?
  title      String     @db.VarChar(160)
  targetDate DateTime?
  status     GoalStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("goals")
}

model CalendarEvent {
  id           String            @id @default(cuid())
  userId       String
  type         CalendarEventType
  title        String            @db.VarChar(160)
  startsAt     DateTime
  endsAt       DateTime
  roomId       String?
  classId      String?
  conferenceId String?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         StudyRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherClass TeacherClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  conference   Conference?       @relation(fields: [conferenceId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@map("calendar_events")
}

// ───────────────────────── Docentes, mentores y conferencias ─────────────────────────

model TeacherClass {
  id          String         @id @default(cuid())
  ownerId     String
  subjectId   String?
  title       String         @db.VarChar(160)
  description String?        @db.VarChar(1000)
  startsAt    DateTime
  durationMin Int
  capacity    Int
  mode        ActivityMode
  status      ActivityStatus @default(DRAFT)
  isDemo      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  owner       User           @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  enrollments ClassEnrollment[]
  materials   ActivityMaterial[]
  calendar    CalendarEvent[]

  @@index([ownerId, startsAt])
  @@map("classes")
}

model ClassEnrollment {
  classId    String
  userId     String
  enrolledAt DateTime     @default(now())
  teacherClass TeacherClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@map("class_enrollments")
}

model Conference {
  id           String         @id @default(cuid())
  hostId       String
  title        String         @db.VarChar(160)
  description  String?        @db.VarChar(1500)
  startsAt     DateTime
  durationMin  Int
  capacity     Int
  mode         ActivityMode
  status       ActivityStatus @default(DRAFT)
  isDemo       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  host         User           @relation("ConferenceHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants ConferenceParticipant[]
  materials    ActivityMaterial[]
  calendar     CalendarEvent[]

  @@index([status, startsAt])
  @@map("conferences")
}

model ConferenceParticipant {
  conferenceId String
  userId       String
  registeredAt DateTime   @default(now())
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conferenceId, userId])
  @@map("conference_participants")
}

// Material de una clase o conferencia: reutiliza LibraryFile (misma validación y moderación).
model ActivityMaterial {
  id           String        @id @default(cuid())
  fileId       String
  classId      String?
  conferenceId String?
  file         LibraryFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  teacherClass TeacherClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  conference   Conference?   @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@map("activity_materials")
}

// ───────────────────────── Negocio ─────────────────────────

model Plan {
  id            String         @id @default(cuid())
  code          PlanCode       @unique
  name          String
  priceCents    Int? // null = sin precio definido todavía (editable en admin)
  currency      String         @default("USD")
  stripePriceId String?
  features      Json
  active        Boolean        @default(true)
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  payments             Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  stripeInvoiceId String        @unique
  amountCents     Int
  currency        String
  status          PaymentStatus
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// Idempotencia: cada evento del proveedor se procesa una sola vez.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String    @db.VarChar(160)
  body      String?   @db.VarChar(400)
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId          String  @id
  streakReminders Boolean @default(false) // desactivado por defecto: sin presión
  sessionReminder Boolean @default(true)
  newConnections  Boolean @default(true)
  newMessages     Boolean @default(true)
  productNews     Boolean @default(false)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Solo contador de uso para aplicar límites por plan. No guarda el contenido de las consultas.
model AiUsage {
  userId      String
  day         DateTime @db.Date
  requests    Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("ai_usage")
}

// Solo se escribe con consentimiento de analítica.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  anonymousId String
  path        String?
  properties  Json?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@map("analytics_events")
}

// ───────────────────────── Contenido editable (admin) ─────────────────────────

model TeamMember {
  id         String  @id @default(cuid())
  name       String
  role       String  @default("Equipo fundador")
  bio        String? @db.VarChar(400)
  photoKey   String?
  sortOrder  Int     @default(0)
  published  Boolean @default(false)

  @@map("team_members")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String? @db.VarChar(600)
  photoKey    String?
  priceCents  Int? // null = no se muestra precio
  sortOrder   Int     @default(0)
  published   Boolean @default(false)

  @@map("products")
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.VarChar(2000)
  sortOrder Int     @default(0)
  published Boolean @default(true)

  @@map("faq_items")
}

model SiteSetting {
  key       String   @id // p. ej. "contact.email", "social.instagram_url"
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(120)
  email     String
  subject   String        @db.VarChar(160)
  message   String        @db.VarChar(3000)
  status    ContactStatus @default(NEW)
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

model ImpactEntry {
  id        String        @id @default(cuid())
  section   ImpactSection
  title     String
  body      String        @db.Text
  sortOrder Int           @default(0)
  published Boolean       @default(false)
  photos    ImpactPhoto[]

  @@index([section, sortOrder])
  @@map("impact_entries")
}

model ImpactPhoto {
  id       String      @id @default(cuid())
  entryId  String
  photoKey String
  alt      String // texto alternativo obligatorio
  caption  String?
  entry    ImpactEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("impact_photos")
}
