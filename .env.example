# ───────── NEXORA · variables de entorno ─────────
# Copia a .env.local (apps/web) y NUNCA subas secretos al repositorio.
# Todo lo marcado OPCIONAL deja la función desactivada y la interfaz
# indica exactamente qué falta; nada se simula.

# Núcleo (obligatorio)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://nexora:nexora_dev_only@localhost:5432/nexora
# Genera con: openssl rand -base64 48
SESSION_SECRET=
# Pepper para hashear IPs en logs: openssl rand -base64 32
LOG_PEPPER=

# Redis (rate limiting y presencia). Sin esto se usa memoria: SOLO desarrollo.
REDIS_URL=redis://localhost:6379

# Contacto público (los defines tú; no se inventan)
CONTACT_EMAIL=
INSTAGRAM_URL=https://www.instagram.com/nexora_sv1/
INSTAGRAM_USERNAME=nexora_sv1

# Correo transaccional (verificación y recuperación) — OPCIONAL hasta Fase 4
EMAIL_PROVIDER=            # resend | smtp
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=

# Google OAuth — OPCIONAL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Almacenamiento de archivos (S3 o Cloudflare R2) — OPCIONAL hasta Fase 7
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_ORIGIN=     # origen permitido para imágenes (CSP)

# Video (LiveKit) — OPCIONAL hasta Fase 9
LIVEKIT_URL=               # wss://...
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Servicio en tiempo real (Yjs: pizarra, temporizador) — OPCIONAL hasta Fase 9
REALTIME_URL=              # wss://...
REALTIME_TOKEN_SECRET=

# NEXORA AI — OPCIONAL hasta Fase 11
AI_PROVIDER=               # anthropic
ANTHROPIC_API_KEY=

# Pagos (Stripe) — OPCIONAL hasta Fase 12
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Analítica (solo se carga con consentimiento) — OPCIONAL
ANALYTICS_PROVIDER=        # plausible | ga4
PLAUSIBLE_DOMAIN=           # única analítica implementada en la Fase 3 (se carga sólo con consentimiento)
GA4_MEASUREMENT_ID=        # pendiente: no implementada todavía

# Indexación en buscadores. Déjalo en false hasta el lanzamiento: mientras sea false,
# todas las páginas llevan noindex y robots.txt bloquea el sitio completo.
SITE_INDEXABLE=false

# Demo de feria
DEMO_ENABLED=true

# MVP 0.1 (apps/mvp)
DATA_DIR=./apps/mvp/data   # carpeta de la base SQLite (en hosting: disco persistente, p. ej. /data)
TRUST_PROXY=0              # 1 si está detrás de un proxy/hosting (usa X-Forwarded-For/Proto)
COOKIE_SECURE=             # vacío = automático según APP_URL (https => Secure)
